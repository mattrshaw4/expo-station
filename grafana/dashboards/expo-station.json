    {
      "type": "timeseries",
      "title": "Log lines by level",
      "id": 19,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Every log line from every service in the stack, counted by level. A red band means something broke. Log scale: Grafana's first-boot burst (~1,000 lines) would otherwise flatten the errors you care about.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum by (level) (count_over_time({project=\"expo-station\"} [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": [
