      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "dish:kitchen_ticket_time_seconds:p95_5m",
          "legendFormat": "{{dish}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
