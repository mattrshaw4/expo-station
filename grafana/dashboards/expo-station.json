{
  "uid": "expo-station",
  "title": "Expo Station",
  "description": "Alerts, golden signals for the kitchen app, container resources, and logs.",
  "tags": [
    "expo-station",
    "kitchen"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 3,
  "panels": [
    {
      "type": "row",
      "title": "On the pass: alerts",
      "id": 24,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Alerts firing",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Alerts Prometheus is sending to Alertmanager right now (includes any Alertmanager is holding back as inhibited).",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "All quiet",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "type": "state-timeline",
      "title": "Alert history",
      "id": 26,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pending = condition true but hasn't lasted the rule's 'for:' window yet. Firing = sent to Alertmanager.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (alertname) (ALERTS{alertstate=\"firing\"}) * 2 or max by (alertname) (ALERTS{alertstate=\"pending\"})",
          "legendFormat": "{{alertname}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No alerts in this window",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Pending"
                },
                "2": {
                  "text": "Firing"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "logs",
      "title": "Ticket printer",
      "id": 27,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Every notification Alertmanager actually sent, after grouping and inhibition. Suppressed alerts never print.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{service=\"printer\"} |~ \"ALERT|ALL CLEAR\" | json | line_format \"{{.msg}}  {{.alertname}}{{if .job}} ({{.job}}){{end}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      }
    },
    {
      "type": "row",
      "title": "The pass: golden signals",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
