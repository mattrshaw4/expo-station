    },
    {
      "type": "timeseries",
      "title": "Rail depth",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Queue depth. If this only goes up, you need another cook (worker).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kitchen_rail_depth",
          "legendFormat": "tickets waiting"
