    },
    {
      "type": "timeseries",
      "title": "Served vs 86'd",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Finished tickets per minute by outcome.",
      "gridPos": {
        "h": 8,
